# ── Copy to .env and fill in. NEVER commit the real .env (it is gitignored). ──

# Required — API keys & Supabase project
gemini_api_key   = YOUR_GEMINI_API_KEY
cohere_api_key   = YOUR_COHERE_API_KEY
project_url      = https://YOUR_PROJECT.supabase.co
service_key      = YOUR_SUPABASE_SERVICE_ROLE_KEY   # privileged, server-side ONLY

# Optional — least-privilege read client (Phase 15).
# If set, read queries use this anon key; with RLS (migration 0005) it can only READ.
anon_key         =

# Optional — enables the in-app "Initialize Database" button (one-click schema setup).
# Use the SESSION POOLER URI (IPv4, port 5432) from Supabase -> Project Settings ->
# Database -> Connection string -> Session pooler. SSL is applied automatically.
supabase_db_url  = postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional tuning (defaults in config.py)
similarity_threshold   = 0.70          # min cosine similarity for a chunk to count
retrieval_match_count  = 10            # vector candidates per query
rerank_top_k           = 6             # chunks sent to the LLM (5-7)
max_upload_mb          = 20            # per-file upload limit
supabase_image_bucket  = rag-images    # Supabase Storage bucket for images
crawl_allowed_domains  =               # comma-separated allowlist; empty = web crawl disabled
crawl_allow_all        = false         # true = allow ANY domain (robots.txt still respected)
dev_mode               = false         # true => per-query diagnostics panel
fallback_message       =               # override the "not found" message if desired
