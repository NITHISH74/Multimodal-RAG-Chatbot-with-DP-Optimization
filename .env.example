# ── Copy to .env and fill in. NEVER commit the real .env (it is gitignored). ──

# Required — API keys & Supabase project
gemini_api_key   = YOUR_GEMINI_API_KEY
cohere_api_key   = YOUR_COHERE_API_KEY
project_url      = https://YOUR_PROJECT.supabase.co
service_key      = YOUR_SUPABASE_SERVICE_ROLE_KEY   # privileged, server-side ONLY

# Optional — anon key. NOTE: setting this alone does NOT change behavior; reads
# use the service client by default. To route reads through the anon key, also
# set use_anon_reads=true AND apply RLS read policies (migration 0005) + grant
# anon SELECT — otherwise anon returns 0 rows and search silently breaks.
anon_key         =
use_anon_reads   = false

# Optional — enables the in-app "Initialize Database" button (one-click schema setup).
# Use the SESSION POOLER URI (IPv4, port 5432) from Supabase -> Project Settings ->
# Database -> Connection string -> Session pooler. SSL is applied automatically.
supabase_db_url  = postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional tuning (defaults shown — change if you want different behaviour)
similarity_threshold   = 0.15          # min cosine similarity for a chunk to count
min_rerank_score       = 0.10          # composite-score floor (strengthened fallback gate)
min_keyword_rank       = 0.05          # ts_rank floor for keyword-only hits
retrieval_match_count  = 10            # vector candidates per query
keyword_match_count    = 10            # keyword candidates per query
rerank_top_k           = 6             # chunks sent to the LLM
max_context_tokens     = 1500          # DP knapsack token budget
max_upload_mb          = 50            # per-file upload limit (raised from 20)
multimodal_mode        = auto          # auto | keyword | off
auto_image_top_k       = 1             # how many images to pull in auto mode
supabase_image_bucket  = rag-images    # Supabase Storage bucket for images
crawl_allowed_domains  =               # comma-separated allowlist; empty = web crawl disabled
crawl_allow_all        = false         # true = allow ANY domain (robots.txt still respected)
dev_mode               = false         # true => per-query diagnostics panel
fallback_message       =               # override the "not found" message if desired

# Guardrails (Phase 2.2)
guardrail_max_query_chars      = 4000  # input guard: hard cap on query length
guardrail_rate_limit_per_min   = 30    # per-user rate limit
output_faithfulness_check      = false # add ~500-1500ms for an LLM-as-judge output check

# Embedding retry / backoff (Phase 3.5)
embed_retry_max         = 2             # retries per model after the first attempt
embed_retry_base_delay  = 0.6           # seconds; doubled each retry
